# 服务器端口
PORT=4000

# 腾讯云 COS 配置
COS_SECRET_ID=your_secret_id_here
COS_SECRET_KEY=your_secret_key_here
COS_BUCKET=wemd-1302564514
COS_REGION=ap-guangzhou

# 存储模式: local | cos
STORAGE_MODE=local

# 微信公众号图片图床
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
# 至少 32 位随机字符；与 WeMD 图床设置中的“上传密钥”保持一致
WECHAT_UPLOAD_KEY=replace_with_a_random_32_character_string
